        // 버튼 데이터 업데이트 및 UI 반영
        private void UpdateTargetButton(int idx, Point p, Bitmap b)
        {
            if (idx == 0) { _btnDown = new CargoButton { Pos = p, Image = b }; picDown.Image = (Bitmap)b.Clone(); }
            else if (idx == 1) { _btnConfirm = new CargoButton { Pos = p, Image = b }; picConfirm.Image = (Bitmap)b.Clone(); }
            else if (idx == 2) { _btnUp = new CargoButton { Pos = p, Image = b }; picUp.Image = (Bitmap)b.Clone(); }
        }

        private void LoadSettings()
        {
            if (!File.Exists(_configPath)) return;
            try
            {
                string[] l = File.ReadAllLines(_configPath);
                if (l.Length >= 14)
                {
                    // IP 및 비율 설정
                    _savedMainIP = l[0]; _savedSubIP = l[1];
                    txtRatioX.Text = l[2]; txtRatioY.Text = l[3];
                    txtRepeat.Text = l[4];

                    // 체크박스 상태
                    chkAlwaysOnTop.Checked = bool.Parse(l[5]);

                    // 시간 설정
                    txtWaitMatch.Text = l[6]; txtWaitAction.Text = l[7]; txtWaitNext.Text = l[8];

                    // 옵션
                    chkCaptureEnable.Checked = bool.Parse(l[9]);
                    chkSoundEnable.Checked = bool.Parse(l[10]);
                    chkAntiKick.Checked = bool.Parse(l[11]);
                    chkSyncMove.Checked = bool.Parse(l[12]);
                    txtSyncDist.Text = l[13];

                    this.TopMost = chkAlwaysOnTop.Checked;
                }

                // 저장된 이미지 복구
                if (l.Length >= 17)
                {
                    _btnDown.Pos = StringToPoint(l[14]);
                    _btnConfirm.Pos = StringToPoint(l[15]);
                    _btnUp.Pos = StringToPoint(l[16]);

                    _btnDown.Image = LoadImageFile("cap_down.png", picDown);
                    _btnConfirm.Image = LoadImageFile("cap_confirm.png", picConfirm);
                    _btnUp.Image = LoadImageFile("cap_up.png", picUp);
                }
            }
            catch { UpdateLog("⚠️ 설정 파일 로드 실패 (초기값 사용)"); }
        }

        private void SaveSettings()
        {
            try
            {
                if (_isMasterRole) { _savedMainIP = GetLocalIP(); _savedSubIP = txtIPInput.Text; }
                else { _savedSubIP = GetLocalIP(); _savedMainIP = txtIPInput.Text; }

                string[] l = new string[17];
                l[0] = _savedMainIP; l[1] = _savedSubIP;
                l[2] = txtRatioX.Text; l[3] = txtRatioY.Text; l[4] = txtRepeat.Text;
                l[5] = chkAlwaysOnTop.Checked.ToString();
                l[6] = txtWaitMatch.Text; l[7] = txtWaitAction.Text; l[8] = txtWaitNext.Text;
                l[9] = chkCaptureEnable.Checked.ToString();
                l[10] = chkSoundEnable.Checked.ToString();
                l[11] = chkAntiKick.Checked.ToString();
                l[12] = chkSyncMove.Checked.ToString();
                l[13] = txtSyncDist.Text;

                // 좌표 저장
                l[14] = $"{_btnDown.Pos.X},{_btnDown.Pos.Y}";
                l[15] = $"{_btnConfirm.Pos.X},{_btnConfirm.Pos.Y}";
                l[16] = $"{_btnUp.Pos.X},{_btnUp.Pos.Y}";

                File.WriteAllLines(_configPath, l);
                SaveImages();
                UpdateLog("💾 설정 및 이미지 저장 완료");
            }
            catch (Exception ex) { UpdateLog($"❌ 저장 실패: {ex.Message}"); }
        }

        private void SaveImages()
        {
            if (!Directory.Exists(_imgDir)) Directory.CreateDirectory(_imgDir);
            if (picDown.Image != null) picDown.Image.Save(Path.Combine(_imgDir, "cap_down.png"), ImageFormat.Png);
            if (picConfirm.Image != null) picConfirm.Image.Save(Path.Combine(_imgDir, "cap_confirm.png"), ImageFormat.Png);
            if (picUp.Image != null) picUp.Image.Save(Path.Combine(_imgDir, "cap_up.png"), ImageFormat.Png);
        }

        // UI 헬퍼 함수들
        private void UpdateRoleUI()
        {
            if (this.InvokeRequired) { this.Invoke(new Action(UpdateRoleUI)); return; }

            // 1. 역할 표시 레이블 (예: lblRole 또는 lblStatus)
            lblRole.Text = _isMasterRole ? "현재 모드: MASTER" : "현재 모드: SUB";
            lblRole.ForeColor = _isMasterRole ? Color.Cyan : Color.Yellow;

            // 2. 버튼 텍스트 변경 (하나의 버튼으로 연결/대기를 다 할 경우)
            btnConnectProcess.Text = _isMasterRole ? "서버 대기 시작" : "마스터에 접속";

            // 3. 내 IP 표시 (예: lblMyIP)
            lblMyIP.Text = $"내 IP: {GetLocalIP()}";
        }

        private void UpdateLog(string m)
        {
            if (this.IsDisposed) return;
            this.BeginInvoke(new Action(() =>
            {
                if (lstLog.Items.Count > 100) lstLog.Items.Clear(); // 로그 100줄 제한
                lstLog.Items.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {m}");
            }));
        }

        private Bitmap LoadImageFile(string fn, PictureBox pb)
        {
            string p = Path.Combine(_imgDir, fn);
            if (!File.Exists(p)) return null;
            using (var temp = new Bitmap(p))
            {
                Bitmap bmp = new Bitmap(temp);
                pb.Image = bmp;
                return bmp;
            }
        }

        private Point StringToPoint(string s) { string[] p = s.Split(','); return new Point(int.Parse(p[0]), int.Parse(p[1])); }
        private bool IsTargetKey(Keys k) => k == Keys.W || k == Keys.A || k == Keys.S || k == Keys.D || k == Keys.F || k == Keys.LShiftKey;
        private int GetInt(TextBox t, int def) => int.TryParse(t.Text, out int r) ? r : def;
        private string GetLocalIP()
        {
            try
            {
                using (Socket s = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, 0))
                {
                    s.Connect("8.8.8.8", 65530);
                    return (s.LocalEndPoint as IPEndPoint).Address.ToString();
                }
            }
            catch { return "127.0.0.1"; }
        }

