        // [역할 전환 버튼 클릭 시 호출]
        private void btnToggleRole_Click(object sender, EventArgs e)
        {
            // 현재 연결되어 있다면 종료 후 전환
            Disconnect();

            _isMasterRole = !_isMasterRole; // 역할 반전
