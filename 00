        #region [6. 매크로 및 이미지 처리 로직]
        private async void StartCargoAutomation()
        {
            if (_btnDown.Image == null || _btnConfirm.Image == null || _btnUp.Image == null)
            {
                UpdateLog("❌ 오류: 버튼 이미지가 모두 설정되지 않았습니다.");
                return;
            }

            _isMacroRunning = true;
            UpdateLog("🚀 카고 오토메이션 시작");

            try
            {
                int repeatCount = GetInt(txtRepeat, 1);

                for (int i = 0; i < repeatCount; i++)
                {
                    if (!_isMacroRunning) break;
                    UpdateLog($"🔄 반복 수행 중... ({i + 1}/{repeatCount})");

                    // 1단계: Down 버튼 찾고 클릭
                    if (!await WaitAndClick(_btnDown, "Down", GetInt(txtWaitMatch, 5000))) break;
                    await Task.Delay(GetInt(txtWaitAction, 500));

                    // 2단계: Confirm 버튼 (서브 연동 포함)
                    if (chkSubManual.Checked)
                    {
                        UpdateLog("📡 서브 PC 클릭 대기 신호 전송...");
                        SendCommand("WAIT_CLICK");
                        // *주의: 여기서 서브 PC의 응답을 기다리는 로직(While loop 등)이 추가로 필요할 수 있음
                        await Task.Delay(2000); // 임시 대기
                    }

                    if (!await WaitAndClick(_btnConfirm, "Confirm", GetInt(txtWaitMatch, 5000))) break;
                    await Task.Delay(GetInt(txtWaitAction, 500));

                    // 3단계: Up 버튼
                    if (!await WaitAndClick(_btnUp, "Up", GetInt(txtWaitMatch, 5000))) break;
                    await Task.Delay(GetInt(txtWaitNext, 1000));
                }
            }
            catch (Exception ex)
            {
                UpdateLog($"💥 매크로 오류 발생: {ex.Message}");
            }
            finally
            {
                _isMacroRunning = false;
                UpdateLog("🏁 매크로 종료됨");
            }
        }

        // 이미지 인식 및 클릭 함수
        private async Task<bool> WaitAndClick(CargoButton btn, string btnName, int timeout)
        {
            if (!_isMacroRunning) return false;

            // 저장된 위치로 커서 이동
            Cursor.Position = btn.Pos;
            await Task.Delay(300);

            Stopwatch sw = Stopwatch.StartNew();
            while (sw.ElapsedMilliseconds < timeout)
            {
                if (!_isMacroRunning) return false;

                // 주변 검색
                if (SearchImageInRange(btn))
                {
                    // 이미지 발견 시 클릭
                    mouse_event(MOUSEEVENTF_LEFTDOWN | MOUSEEVENTF_LEFTUP, 0, 0, 0, 0);
                    UpdateLog($"🎯 [{btnName}] 인식 성공 & 클릭");
                    return true;
                }
                await Task.Delay(200); // 0.2초 간격 재검사
            }

            UpdateLog($"❌ [{btnName}] 인식 실패 (시간 초과)");
            return false;
        }

        // 픽셀 오차 허용 비교 (Range Search)
        private bool SearchImageInRange(CargoButton btn)
        {
            int range = 3; // 검색 범위 (픽셀)
            for (int ox = -range; ox <= range; ox++)
            {
                for (int oy = -range; oy <= range; oy++)
                {
                    // 현재 검사할 화면 좌표
                    Point searchPos = new Point(btn.Pos.X + ox, btn.Pos.Y + oy);
                    if (IsMatchAt(btn.Image, searchPos)) return true;
                }
            }
            return false;
        }

        // 픽셀 단위 색상 비교 (RGB 오차 25 허용)
        private bool IsMatchAt(Bitmap target, Point p)
        {
            if (target == null) return false;
            using (Bitmap screenPixel = new Bitmap(10, 10))
            {
                using (Graphics g = Graphics.FromImage(screenPixel))
                {
                    g.CopyFromScreen(p.X - 5, p.Y - 5, 0, 0, new Size(10, 10));
                }

                for (int x = 0; x < 10; x++)
                {
                    for (int y = 0; y < 10; y++)
                    {
                        Color cTarget = target.GetPixel(x, y);
                        Color cScreen = screenPixel.GetPixel(x, y);

                        if (Math.Abs(cTarget.R - cScreen.R) > 25 ||
                            Math.Abs(cTarget.G - cScreen.G) > 25 ||
                            Math.Abs(cTarget.B - cScreen.B) > 25)
                        {
                            return false; // 하나라도 오차 넘으면 불일치
                        }
                    }
                }
                return true;
            }
        }

        // 10회 캡처 후 평균 이미지 생성 (노이즈 제거)
        private async Task<Bitmap> CaptureAverageImage(Point fPos)
        {
            int w = 10, h = 10, s = 10;
            long[,] rS = new long[w, h], gS = new long[w, h], bS = new long[w, h];

            for (int i = 0; i < s; i++)
            {
                using (Bitmap bmp = new Bitmap(w, h))
                {
                    using (Graphics g = Graphics.FromImage(bmp))
                        g.CopyFromScreen(fPos.X - 5, fPos.Y - 5, 0, 0, new Size(w, h));

                    for (int x = 0; x < w; x++)
                        for (int y = 0; y < h; y++)
                        {
                            Color c = bmp.GetPixel(x, y);
                            rS[x, y] += c.R; gS[x, y] += c.G; bS[x, y] += c.B;
                        }
                }
                await Task.Delay(50);
            }

            Bitmap avg = new Bitmap(w, h);
            for (int x = 0; x < w; x++)
                for (int y = 0; y < h; y++)
                    avg.SetPixel(x, y, Color.FromArgb((int)(rS[x, y] / s), (int)(gS[x, y] / s), (int)(bS[x, y] / s)));

            return avg;
        }
