        // 빈 설정 로드/저장 함수 (필요시 내용 채워넣기)

        private void LoadSettings()
        {
            UpdateLog("📂 설정을 로드하는 중...");

            if (!File.Exists(_configPath))
            {
                UpdateLog("⚠️ 설정 파일(config.txt)이 없습니다. 기본값을 사용합니다.");
                return;
            }

            try
            {
                string[] l = File.ReadAllLines(_configPath);
                UpdateLog($"📄 파일 읽기 완료: 총 {l.Length}라인 확인됨.");

                // 1. 최소 14줄 이상이어야 기본 설정 로드
                if (l.Length >= 14)
                {
                    // IP 설정 (변수에 저장)
                    _savedMainIP = l[0];
                    _savedSubIP = l[1];

                    // 현재 역할에 맞춰 TargetIP 입력창 채우기
                    // 마스터면 보조IP를, 보조면 마스터IP를 타겟창에 표시
                    txtTargetIP.Text = _isMasterRole ? _savedSubIP : _savedMainIP;

                    // 텍스트 필드 로드
                    txtRatioX.Text = l[2];
                    txtRatioY.Text = l[3];
                    txtRepeat.Text = l[4];

                    // 체크박스 안전하게 파싱 (에러 방지용)
                    chkAlwaysOnTop.Checked = TryParseBool(l[5], false);
                    this.TopMost = chkAlwaysOnTop.Checked;

                    // 시간 및 거리 설정
                    txtWaitMatch.Text = l[6];
                    txtWaitAction.Text = l[7];
                    txtWaitNext.Text = l[8];

                    // 기타 옵션
                    chkCaptureEnable.Checked = TryParseBool(l[9], false);
                    chkSoundEnable.Checked = TryParseBool(l[10], true);
                    chkAntiKick.Checked = TryParseBool(l[11], false);
                    chkSyncMove.Checked = TryParseBool(l[12], true);
                    txtSyncDist.Text = l[13];

                    UpdateLog("✅ 기본 환경 설정 로드 성공");
                }
                else
                {
                    UpdateLog("⚠️ 설정 파일 형식이 올바르지 않습니다. (라인 부족)");
                }

                // 2. 17줄 이상이면 좌표 및 이미지 복구
                if (l.Length >= 17)
                {
                    try
                    {
                        _btnDown.Pos = StringToPoint(l[14]);
                        _btnConfirm.Pos = StringToPoint(l[15]);
                        _btnUp.Pos = StringToPoint(l[16]);

                        _btnDown.Image = LoadImageFile("cap_down.png", picDown);
                        _btnConfirm.Image = LoadImageFile("cap_confirm.png", picConfirm);
                        _btnUp.Image = LoadImageFile("cap_up.png", picUp);

                        UpdateLog("🖼️ 버튼 좌표 및 이미지 복구 완료");
                    }
                    catch
                    {
                        UpdateLog("⚠️ 좌표/이미지 데이터 복구 중 오류 발생");
                    }
                }
            }
            catch (Exception ex)
            {
                UpdateLog($"❌ 설정 로드 중 치명적 오류: {ex.Message}");
            }
        }

        private void SaveSettings()
        {
            try
            {
                // 1. IP 및 기본 설정 저장
                if (_isMasterRole) { _savedMainIP = GetLocalIP(); _savedSubIP = txtTargetIP.Text; }
                else { _savedSubIP = GetLocalIP(); _savedMainIP = txtTargetIP.Text; }

                string[] l = new string[17];
                l[0] = _savedMainIP; l[1] = _savedSubIP;
                l[2] = txtRatioX.Text; l[3] = txtRatioY.Text; l[4] = txtRepeat.Text;
                l[5] = chkAlwaysOnTop.Checked.ToString();
                l[6] = txtWaitMatch.Text; l[7] = txtWaitAction.Text; l[8] = txtWaitNext.Text;
                l[9] = chkCaptureEnable.Checked.ToString();
                l[10] = chkSoundEnable.Checked.ToString();
                l[11] = chkAntiKick.Checked.ToString();
                l[12] = chkSyncMove.Checked.ToString();
                l[13] = txtSyncDist.Text;

                // 좌표 저장
                l[14] = $"{_btnDown.Pos.X},{_btnDown.Pos.Y}";
                l[15] = $"{_btnConfirm.Pos.X},{_btnConfirm.Pos.Y}";
                l[16] = $"{_btnUp.Pos.X},{_btnUp.Pos.Y}";

                File.WriteAllLines(_configPath, l);
                SaveImages();
                UpdateLog("💾 설정 및 이미지 저장 완료");
            }
            catch (Exception ex) { UpdateLog($"❌ 저장 실패: {ex.Message}"); }
        }

