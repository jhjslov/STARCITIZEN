        /// <summary>
        /// 개별 이미지를 파일로 저장하는 헬퍼 함수
        /// </summary>
        private void SaveSingleImage(Image img, string fileName)
        {
            if (img == null) return;

            string fullPath = Path.Combine(_imgDir, fileName);

            try
            {
                // 파일이 이미 존재한다면 교체하기 위해 새 비트맵으로 복사 후 저장
                // (기존 파일이 로드되어 사용 중인 경우를 대비)
                using (Bitmap bmpToSave = new Bitmap(img))
                {
                    bmpToSave.Save(fullPath, ImageFormat.Png);
                }
            }
            catch (IOException)
            {
                // 파일이 다른 프로세스에 의해 사용 중일 때의 예외 처리
                UpdateLog($"⚠️ 파일 사용 중으로 저장 불가: {fileName}");
            }
        }

        // 이미지 로드 (파일 잠금 방지)
        private Bitmap LoadImageFile(string fn, PictureBox pb)
        {
            string p = Path.Combine(_imgDir, fn);
            if (!File.Exists(p)) return null;
            try
            {
                using (var temp = new Bitmap(p))
                {
                    Bitmap bmp = new Bitmap(temp);
                    pb.Image = bmp;
                    return bmp;
                }
            }
            catch { return null; }
        }
        /// "X,Y" 형식의 문자열을 Point 객체로 변환합니다. 변환 실패 시 0,0을 반환합니다.
        private Point StringToPoint(string s)
        {
            // 1. 빈 문자열 체크
            if (string.IsNullOrWhiteSpace(s)) return new Point(0, 0);

            try
            {
                string[] parts = s.Split(',');

                // 2. 형식이 올바른지 확인 (X와 Y 두 개가 있어야 함)
                if (parts.Length >= 2)
                {
                    // 3. 숫자로 안전하게 변환 시도
                    bool successX = int.TryParse(parts[0].Trim(), out int x);
                    bool successY = int.TryParse(parts[1].Trim(), out int y);

                    if (successX && successY)
                    {
                        return new Point(x, y);
                    }
                }

                // 형식이 틀린 경우 로그 출력
                UpdateLog($"⚠️ 좌표 변환 실패 (잘못된 형식): {s}");
            }
            catch (Exception ex)
            {
                UpdateLog($"❌ StringToPoint 오류: {ex.Message}");
            }

            return new Point(0, 0); // 실패 시 기본 좌표 반환
        }
        private bool TryParseBool(string input, bool defaultValue)
        {
            return bool.TryParse(input, out bool result) ? result : defaultValue;
        }

        /// 상태 표시 라벨을 잠시 녹색으로 반짝이게 하여 동작 여부를 시각화합니다.
        private void FlashStatusLabel()
        {
            // 창 핸들이 없거나 폼이 닫히는 중이면 실행하지 않음 (에러 방지)
            if (this.IsDisposed || !this.IsHandleCreated) return;

            try
            {
                this.BeginInvoke(new Action(() =>
                {
                    // 1. 강조색으로 변경 (녹색)
                    lblStatus.BackColor = Color.Lime;
                    lblStatus.ForeColor = Color.Black; // 글자색도 명확하게 변경

                    // 2. 타이머를 생성하여 100ms 후에 원래대로 복구
                    var flashTimer = new System.Windows.Forms.Timer { Interval = 100 };
                    flashTimer.Tick += (s, e) =>
                    {
                        // 원래 투명(또는 부모 배경색)으로 복구
                        lblStatus.BackColor = Color.Transparent;
                        lblStatus.ForeColor = Color.White; // 기존 글자색으로 (사용자 설정에 맞게 수정)

                        flashTimer.Stop();
                        flashTimer.Dispose();
                    };
                    flashTimer.Start();
                }));
            }
            catch (Exception ex)
            {
                // UI 스레드 에러 발생 시 디버그 출력
                Debug.WriteLine($"FlashStatusLabel Error: {ex.Message}");
            }
        }

