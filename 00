        }

        // [네트워크 연결/대기 통합 함수]
        // [연결 또는 대기 버튼 클릭 시]
        private async void btnConnectProcess_Click(object sender, EventArgs e)
        {
            // 이미 연결된 경우 연결 끊기 기능으로 동작
            if (_isConnected)
            {
                Disconnect();
                return;
            }

            if (_isMasterRole)
            {
                // [마스터 모드] 서버로서 대기
                try
                {
                    _listener = new TcpListener(IPAddress.Any, 9000);
                    _listener.Start();
                    UpdateLog("⏳ [마스터] 보조 PC의 접속을 기다리는 중...");

                    _client = await _listener.AcceptTcpClientAsync();
                    _stream = _client.GetStream();
                    _isConnected = true;
                    UpdateLog("✅ 보조 PC와 연결되었습니다.");
                    ReceiveMessagesLoop();
                }
                catch (Exception ex) { UpdateLog($"❌ 서버 시작 실패: {ex.Message}"); }
            }
            else
            {
                // [보조 모드] 입력된 Target IP로 접속
                try
                {
                    _client = new TcpClient();
                    // 사용자님의 Target IP 입력창 이름을 확인하세요 (예: txtTargetIP)
                    string targetIP = txtIPInput.Text;
                    UpdateLog($"⏳ [보조] 마스터({targetIP}) 접속 시도 중...");

                    await _client.ConnectAsync(targetIP, 9000);
                    _stream = _client.GetStream();
                    _isConnected = true;
                    UpdateLog("✅ 마스터 PC에 연결되었습니다.");
                    ReceiveMessagesLoop();
                }
                catch (Exception ex) { UpdateLog($"❌ 접속 실패: {ex.Message}"); }
            }
        }
        #endregion

        private void Disconnect()
        {
            try
            {
                _isConnected = false;

                if (_stream != null) { _stream.Close(); _stream = null; }
                if (_client != null) { _client.Close(); _client = null; }
                if (_listener != null) { _listener.Stop(); _listener = null; }

                UpdateLog("🔌 연결이 종료되었습니다.");
            }
            catch (Exception ex)
            {
                UpdateLog($"⚠️ 연결 종료 중 오류: {ex.Message}");
            }
        }
        // [메시지 수신 루프] - 비동기
        private async void ReceiveMessagesLoop()
        {
            byte[] buffer = new byte[1024];
            while (_isConnected)
            {
                try
                {
                    int bytesRead = await _stream.ReadAsync(buffer, 0, buffer.Length);
                    if (bytesRead == 0) break; // 연결 끊김

                    string msg = Encoding.UTF8.GetString(buffer, 0, bytesRead);
                    ProcessReceivedMessage(msg); // 메시지 처리 함수로 전달
                }
                catch
                {
                    _isConnected = false;
                    UpdateLog("⚠️ 연결이 종료되었습니다.");
                    break;
                }
            }
        }

        // [메시지 처리]
        private void ProcessReceivedMessage(string msg)
        {
            // 명령어가 여러 개 뭉쳐 올 수 있으므로 분리
            string[] commands = msg.Split(new[] { "\r\n", "|" }, StringSplitOptions.RemoveEmptyEntries);

            foreach (var cmd in commands)
            {
                // 1. 마우스 이동 동기화
                if (cmd.StartsWith("M_MOVE"))
                {
                    // 예: M_MOVE, 10, -5 -> 파싱 로직 필요 (구현 생략 가능하나 상세 구현 추천)
                    // 현재 구조상 Split 처리가 필요함.
                }
                // 2. 키 입력
                else if (cmd.StartsWith("K_DOWN")) { /* 키 누름 처리 */ }
                else if (cmd.StartsWith("K_UP")) { /* 키 뗌 처리 */ }

                // 3. 매크로 신호
                else if (cmd == "WAIT_CLICK")
                {
                    _waitingForUserClick = true;
                    UpdateLog("🔔 [알림] 메인 PC가 클릭을 기다립니다! 화면을 클릭하세요.");
                    this.Invoke(new Action(() => this.Activate())); // 창 활성화
                }
                else if (cmd == "SUB_READY")
                {
                    // 메인 PC가 받음: 서브가 클릭했음을 인지
                    UpdateLog("✅ 서브 PC 클릭 확인됨. 매크로 진행.");
                }
            }
        }

        // [명령어 전송]
        private void SendCommand(string msg)
        {
            if (_isConnected && _stream != null && _stream.CanWrite)
            {
                try
                {
                    byte[] data = Encoding.UTF8.GetBytes(msg);
                    _stream.Write(data, 0, data.Length);
                }
                catch { UpdateLog("⚠️ 데이터 전송 실패"); }
            }
        }

        #region [5. 입력 후킹 및 이벤트 핸들러]
        private void SubscribeGlobalHooks()
        {
            _globalHook = Hook.GlobalEvents();

            // [마우스 이동] - 동기화 켜져있고 메인일 때만 기록
            _globalHook.MouseMove += (s, e) =>
            {
                if (!_isSyncEnabled || !_isMasterRole) { _lastPos = e.Location; return; }
                _deltaX += e.X - _lastPos.X;
                _deltaY += e.Y - _lastPos.Y;
                _lastPos = e.Location;
            };

            // [마우스 클릭]
            _globalHook.MouseDown += async (s, e) =>
            {
                // A. [서브 PC] 수동 클릭 모드
                if (!_isMasterRole && chkSubManual.Checked && _waitingForUserClick)
                {
                    if (e.Button == MouseButtons.Left)
                    {
                        _waitingForUserClick = false;
                        UpdateLog("🖱️ [수동] 사용자 클릭 완료 -> 신호 전송");
                        SendCommand("SUB_READY");
                        return; // 클릭 이벤트를 전파하지 않고 여기서 끝냄
                    }
                }

                // B. [메인 PC] 우클릭으로 버튼 좌표/이미지 캡처
                if (_isMasterRole && e.Button == MouseButtons.Right)
                {
                    Point currentPos = e.Location;

                    // 개별 수정 모드
                    if (_editTarget != -1)
                    {
                        UpdateLog($"📸 [수정] {_editTarget + 1}번 버튼 재설정 중...");
                        Bitmap bmp = await CaptureAverageImage(currentPos);
                        UpdateTargetButton(_editTarget, currentPos, bmp);
                        _editTarget = -1; // 모드 초기화
                    }
                    // 순차 캡처 모드
                    else if (chkCaptureEnable.Checked)
                    {
                        UpdateLog($"📸 [순차] {_captureIndex + 1}/3 버튼 캡처...");
                        Bitmap bmp = await CaptureAverageImage(currentPos);
                        UpdateTargetButton(_captureIndex, currentPos, bmp);

                        _captureIndex = (_captureIndex + 1) % 3; // 0 -> 1 -> 2 -> 0
                        if (_captureIndex == 0) UpdateLog("🎉 모든 버튼 설정 완료!");
                    }
                }
            };

            // [키보드 입력]
            _globalHook.KeyDown += (s, e) =>
            {
                // F12: 동기화 토글
                if (e.KeyCode == Keys.F12)
                {
                    _isSyncEnabled = !_isSyncEnabled;
                    UpdateLog(_isSyncEnabled ? "▶ 동기화 시작 (ON)" : "■ 동기화 중지 (OFF)");
                }
                // F3: 매크로 시작/중지 (메인만)
                else if (e.KeyCode == Keys.F3 && _isMasterRole)
                {
                    if (!_isMacroRunning) StartCargoAutomation();
                    else
                    {
                        _isMacroRunning = false;
                        UpdateLog("🛑 사용자에 의한 매크로 중단 요청");
                    }
                }
                // 이동키(WASD) 동기화 전송
                else if (_isSyncEnabled && _isMasterRole && IsTargetKey(e.KeyCode))
                {
                    SendCommand($"K_DOWN|{e.KeyCode}");
                }
            };

            _globalHook.KeyUp += (s, e) =>
            {
                if (_isSyncEnabled && _isMasterRole && IsTargetKey(e.KeyCode))
                    SendCommand($"K_UP|{e.KeyCode}");
            };
        }

        // 동기화 타이머 틱 핸들러
        private void SyncTimer_Tick(object sender, EventArgs e)
        {
            if (_isSyncEnabled && _isMasterRole && (_deltaX != 0 || _deltaY != 0))
            {
                double.TryParse(txtRatioX.Text, out double rX);
                double.TryParse(txtRatioY.Text, out double rY);

                int sendX = (int)(_deltaX * (rX == 0 ? 1 : rX));
                int sendY = (int)(_deltaY * (rY == 0 ? 1 : rY));

                SendCommand($"M_MOVE|{sendX}|{sendY}");
                _deltaX = 0; _deltaY = 0;
            }
        }
