        // 마우스 전역 훅에서 호출되는 부분
        private void OnMouseMove(int x, int y)
        {
            // 1. 캐릭터 동기화 활성화 여부 확인 (chkSyncMove가 아닌 isSyncEnabled 사용)
            if (!_isConnected || !_isSyncEnabled || !_isMasterRole) return;

            // 2. 배율 조정 (txtRatioX, txtRatioY 활용)
            double ratioX = GetDouble(txtRatioX, 1.0);
            double ratioY = GetDouble(txtRatioY, 1.0);

            int targetX = (int)(x * ratioX);
            int targetY = (int)(y * ratioY);

            // 3. 전송 부하 방지 (최소 2픽셀 이상 움직였을 때만 전송)
            if (Math.Abs(_lastSentPos.X - targetX) < 2 && Math.Abs(_lastSentPos.Y - targetY) < 2) return;

            // 4. 서브 PC로 "배율이 적용된 좌표" 전송
            SendCommand($"MOVE|{targetX}|{targetY}");
            _lastSentPos = new Point(targetX, targetY);
        }

        private void Form1_KeyDown(object sender, KeyEventArgs e)
        {
            if (!_isSyncEnabled || !_isConnected) return;

            // 동기화할 키 목록
            if (e.KeyCode == Keys.W || e.KeyCode == Keys.A || e.KeyCode == Keys.S ||
                e.KeyCode == Keys.D || e.KeyCode == Keys.ShiftKey || e.KeyCode == Keys.F)
            {
                SendCommand($"KEY_DOWN|{(int)e.KeyCode}");
            }
        }

        private void Form1_KeyUp(object sender, KeyEventArgs e)
        {
            if (!_isSyncEnabled || !_isConnected) return;

            if (e.KeyCode == Keys.W || e.KeyCode == Keys.A || e.KeyCode == Keys.S ||
                e.KeyCode == Keys.D || e.KeyCode == Keys.ShiftKey || e.KeyCode == Keys.F)
            {
                SendCommand($"KEY_UP|{(int)e.KeyCode}");
            }
        }

        private void HandleKeySync(string msg)
        {
            string[] parts = msg.Split('|');
            if (parts.Length < 2) return;

            int keyCode = int.Parse(parts[1]);
            bool isDown = msg.StartsWith("KEY_DOWN");

            // 윈도우 가상 키코드를 스캔코드로 변환 (게임 인식률을 위해)
            uint scanCode = MapVirtualKey((uint)keyCode, 0);

            if (isDown)
            {
                // 키 누름 (0x0008은 스캔코드 모드 전용 플래그일 수 있음, 환경에 따라 조정)
                keybd_event((byte)keyCode, (byte)scanCode, 0, 0);
            }
            else
            {
                // 키 뗌
                keybd_event((byte)keyCode, (byte)scanCode, 2, 0);
            }
        }

