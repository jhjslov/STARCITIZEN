        #region [5. 입력 후킹 (Mouse/Keyboard Hook)]
        private void SubscribeHooks()
        {
            _globalHook = Hook.GlobalEvents();

            // [마우스 이동] 동기화 ON & 마스터일 때만 동작
            _globalHook.MouseMove += (s, e) =>
            {
                if (_isDragging)
                {
                    // 드래그 영역 계산 후 오버레이 폼에 전달
                    Rectangle rect = GetRect(_dragStart, e.Location);
                    // [수정 부분] _overlay가 null이 아닐 때만 속성에 접근하도록 합니다.
                    if (_overlay != null && !_overlay.IsDisposed)
                    {
                        _overlay.CurrentDragRect = rect;
                        _overlay.Invalidate();
                    }

                }
                if (!_isSyncEnabled || !_isMasterRole)
                {
                    _lastPos = e.Location;
                    return;
                }

                // 전송하지 않고 값만 누적
                _accumulatedDX += e.X - _lastPos.X;
                _accumulatedDY += e.Y - _lastPos.Y;

                _lastPos = e.Location;
            };

            // [마우스 클릭]
            _globalHook.MouseDown += async (s, e) =>
            {
                // A. 서브 PC 수동 클릭 모드
                if (!_isMasterRole && chkSubManual.Checked && _waitingForUserClick)
                {
                    if (e.Button == MouseButtons.Left)
                    {
                        _waitingForUserClick = false;
                        UpdateLog("🖱️ [보조] 클릭 완료 -> 마스터에 신호 전송");
                        SendCommand("SUB_READY");
                    }
                    return;
                }

                // B. 마스터 PC 드래그 및 캡처 시작 (왼쪽 버튼)
                if (_isMasterRole && e.Button == MouseButtons.Left && chkCaptureEnable.Checked)
                {
                    _dragStart = e.Location;
                    _isDragging = true;
                    return; // 드래그 시작 시 다른 로직 중단
                }

                // B-2. 마스터 PC 좌표 보정 (우클릭) - 기존 로직에 오버레이 연동 추가
                if (_isMasterRole && e.Button == MouseButtons.Right)
                {
                    Point fixedPos = e.Location;
                    if (_editTarget != -1)  // --- 상황 A: 개별 수정 모드 (체크박스 여부와 상관없이 작동)
                    {
                        
                        UpdateLog($"📸 [개별 캡처] 시작 (좌표: {fixedPos.X}, {fixedPos.Y})");
                        Bitmap avgCap = await CaptureAverageImage(fixedPos);

                        if (_editTarget == 0)
                        {
                            _btnDown = new CargoButton { Pos = fixedPos, Image = avgCap, Name = "Down" };
                            picDown.Image = (Bitmap)avgCap.Clone();
                        }
                        else if (_editTarget == 1)
                        {
                            _btnConfirm = new CargoButton { Pos = fixedPos, Image = avgCap, Name = "Confirm" };
                            picConfirm.Image = (Bitmap)avgCap.Clone();
                        }
                        else if (_editTarget == 2)
                        {
                            _btnUp = new CargoButton { Pos = fixedPos, Image = avgCap, Name = "Up" };
                            picUp.Image = (Bitmap)avgCap.Clone();
                        }

                        _editTarget = -1; // 수정 모드 초기화
                        UpdateLog("✅ 개별 버튼 수정 완료 (저장 버튼을 눌러 확정하세요)");
                        return;
                    }


                    if (chkCaptureEnable.Checked) // --- 상황 B: 일반 순차 캡처 모드 (체크박스 켜져 있을 때만)
                    {
                        Point currentPos = e.Location;
                        Bitmap bmp = await CaptureAverageImage(currentPos); // 10회 평균 캡처

                        // 개별 수정 모드
                        if (_editTarget != -1)
                        {
                            UpdateTargetButton(_editTarget, currentPos, bmp);
                            _editTarget = -1;
                        }
                        // 순차 캡처 모드
                        else
                        {
                            UpdateTargetButton(_captureIndex, currentPos, bmp);
                            _captureIndex = (_captureIndex + 1) % 3; // 0->1->2 순환
                        }
                    }
                }
            };

            _globalHook.MouseUp += async (s, e) => {
                if (_isDragging && e.Button == MouseButtons.Left)
                {
                    _isDragging = false;
                    Rectangle finalRect = GetRect(_dragStart, e.Location);
                    // [수정 부분] _overlay가 null이 아닐 때만 속성에 접근하도록 합니다.
                    if (_overlay != null && !_overlay.IsDisposed)
                    {
                        _overlay.CurrentDragRect = Rectangle.Empty;
                        _overlay.Invalidate();
                    }

                    if (finalRect.Width > 10 && finalRect.Height > 10)
                    {
                        Bitmap cap = CaptureRectImage(finalRect);
                        await ProcessCapturedItem(cap, finalRect); // 0~3단계 순차 저장
                    }
                }
            };

            // [키보드] F12, F3 등 단축키 처리
            _globalHook.KeyDown += (s, e) =>
            {
                if (_isMasterRole && _isSyncEnabled)
                {
                    // 2. 키보드 필터링 적용 (WASD, F, Shift 등 특정 키만 전송)
                    if (IsMovementKey(e.KeyCode))
                    {
                        SendCommand($"KD|{(int)e.KeyCode}");
                    }
                }
                // 단축키 제어 (이건 각 PC에서 독립적으로 동작하거나 마스터만 동작)
                if (e.KeyCode == Keys.F12)
                {
                    _isSyncEnabled = !_isSyncEnabled;
                    UpdateLog(_isSyncEnabled ? "▶ 동기화 시작" : "■ 동기화 중지");
                }
                else if (e.KeyCode == Keys.F3 && _isMasterRole)
                {
                    if (!_isMacroRunning) StartCargoAutomation();
                    else
                    {
                        _isMacroRunning = false;
                        UpdateLog("🛑 [F3] 사용자에 의한 매크로 중단");
                    }
                }
            };
            _globalHook.KeyUp += (s, e) =>
            {
                if (_isMasterRole && _isSyncEnabled)
                {
                    if (IsMovementKey(e.KeyCode))
                    {
                        SendCommand($"KU|{(int)e.KeyCode}");
                    }
                }
            };
        }

        // 동기화 타이머 (너무 잦은 전송 방지)
        private void InitSyncTimer()
        {
            _syncTimer = new System.Windows.Forms.Timer();
            _syncTimer.Interval = 80; // 10ms 설정
            _syncTimer.Tick += (s, e) => {
                if (_isMasterRole && _isSyncEnabled)
                {
                    // 누적된 값이 있을 때만 전송
                    if (_accumulatedDX != 0 || _accumulatedDY != 0)
                    {
                        SendCommand($"MOVE|{_accumulatedDX}|{_accumulatedDY}");
                        //UpdateLog($"[Send] MOVE|{_accumulatedDX}|{_accumulatedDY}");

                        // 전송 후 누적값 초기화
                        _accumulatedDX = 0;
                        _accumulatedDY = 0;
                    }
                }
            };
            _syncTimer.Start();
        }
