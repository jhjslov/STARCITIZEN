        #region [6. 매크로 및 이미지 처리]
        private async void StartCargoAutomation()
        {
            if (_btnDown.Image == null || _btnConfirm.Image == null || _btnUp.Image == null)
            {
                UpdateLog("❌ 오류: 버튼 3종 이미지가 없습니다.");
                return;
            }

            try
            {
                _isMacroRunning = true;
                int totalRepeat = GetInt(txtRepeat, 1);
                UpdateLog($"▶ 매크로 시작 (총 {totalRepeat}회 진행)");

                for (int i = 1; i <= totalRepeat && _isMacroRunning; i++)
                {
                    UpdateLog($"--- {i} / {totalRepeat} 회차 진행 중 ---");

                    // 1. CargoDown 단계
                    if (!await WaitAndClick(_btnDown, "Down", GetInt(txtWaitMatch, 5000))) break;
                    await Task.Delay(500);

                    // 2. Confirm 인식 단계 (이전 코드의 정밀 로직 유지)
                    await Task.Delay(GetInt(txtWaitConfirm, 1000));
                    Cursor.Position = _btnConfirm.Pos;
                    if (!await WaitAndMatchOnly(_btnConfirm, "Confirm", GetInt(txtWaitMatch, 5000))) break;

                    // 3. 서브 PC 1차 동작 요청 (클릭 지시)
                    _isSubReady = false;
                    SendCommand("SUB_ACTION_1"); // 보조 PC에 동작 신호 송신
                    string modeText = chkSubManual.Checked ? "수동 클릭" : "자동 동작";  // 디자인의 chkSubManual이 체크되어 있다면 로그를 다르게 표시
                    UpdateLog("📡 서브 PC 1차 동작 요청 중...");

                    // [타임아웃 적용] 서브 PC 응답 대기
                    if (!await WaitForSubResponse(5000))
                    {
                        UpdateLog("🛑 서브 응답 없음: 매크로를 강제 종료합니다.");
                        break;
                    }

                    // 마스터 본인도 클릭 수행 (이전 코드 로직)
                    await Task.Delay(GetInt(txtWaitClick, 500));
                    mouse_event(0x0002 | 0x0004, 0, 0, 0, 0);
                    UpdateLog("🖱️ 마스터 클릭 완료");

                    // 4. CargoUp 단계 (txtWaitUp 연결)
                    int waitUp = GetInt(txtWaitUp, 7800);
                    UpdateLog($"⏳ Up 대기: {waitUp}ms");
                    await Task.Delay(waitUp);
                    if (!await WaitAndClick(_btnUp, "Up", GetInt(txtWaitMatch, 5000))) break;

                    // 5. ESC 단계 (txtWaitEsc 연결)
                    int waitEsc = GetInt(txtWaitEsc, 7500);
                    await SendKeyScan(0x01, 150); // ESC 스캔코드
                    UpdateLog($"⌨️ ESC 입력 후 {waitEsc}ms 대기...");
                    await Task.Delay(waitEsc);

                    // 서브 PC 2차 동작 요청
                    _isSubReady = false;
                    SendCommand("SUB_ACTION_2");
                    UpdateLog("📡 서브 PC 2차 동작 요청 중...");

                    if (!await WaitForSubResponse(5000))
                    {
                        UpdateLog("🛑 서브 2차 응답 없음: 종료합니다.");
                        break;
                    }

                    // 6. 마무리 동작 (txtWaitAction 연결)
                    int waitAction = GetInt(txtWaitAction, 500); // 디자인의 'Wait F' 값
                    UpdateLog($"⌨️ 마무리 F 키 입력 (대기: {waitAction}ms)");
                    await Task.Delay(waitAction);
                    await SendKeyScan(0x21, 100); // F키
                    await Task.Delay(200);        // 연타 사이 간격
                    await SendKeyScan(0x21, 100);
                    // 다음 회차 대기
                    int nextWait = GetInt(txtWaitNext, 2000);
                    UpdateLog($"회차 종료. {nextWait}ms 후 다음 회차 시작...");
                    await Task.Delay(nextWait);
                }
            }
            catch (Exception ex) { UpdateLog($"❌ 에러 발생: {ex.Message}"); }
            finally
            {
                _isMacroRunning = false;
                UpdateLog("🏁 모든 매크로 시퀀스 종료");
                if (chkSoundEnable.Checked) System.Media.SystemSounds.Asterisk.Play();
            }
        }

        // 서브 PC 응답 대기 (타임아웃 포함)
        private async Task<bool> WaitForSubResponse(int timeoutMs)
        {
            Stopwatch sw = Stopwatch.StartNew();
            while (!_isSubReady)
            {
                if (!_isMacroRunning || sw.ElapsedMilliseconds > timeoutMs) return false;
                await Task.Delay(100);
            }
            return true;
        }

        // [헬퍼] 클릭 없이 인식만 하는 함수 (Confirm 단계용)
        private async Task<bool> WaitAndMatchOnly(CargoButton btn, string name, int timeout)
        {
            Stopwatch sw = Stopwatch.StartNew();
            UpdateLog($"🔍 Confirm 인식 대기 중... ({timeout}ms)");

            while (sw.ElapsedMilliseconds < timeout)
            {
                if (!_isMacroRunning) return false;

                // 사용자님이 제안하신 최적화된 스캔 방식 사용
                if (SearchImageInRange(btn))
                {
                    UpdateLog($"✅ Confirm 포착됨");
                    return true;
                }
                await Task.Delay(200);
            }

            UpdateLog($"❌ [{name}] 인식 실패 (타임아웃)");
            return false;
        }

        // 이미지 서칭 및 클릭 함수
        private async Task<bool> WaitAndClick(CargoButton btn, string stepName, int timeout)
        {
            Stopwatch sw = Stopwatch.StartNew();
            UpdateLog($"⏳ [{stepName}] 대기 중... (제한시간: {timeout}ms)");

            // 1. 타겟 좌표로 마우스 이동
            Cursor.Position = btn.Pos;
            await Task.Delay(200);

            // 2. 시간 내에 이미지가 나타날 때까지 반복 확인
            while (sw.ElapsedMilliseconds < timeout)
            {
                if (!_isMacroRunning) return false;

                if (SearchImageInRange(btn)) // 이미지 인식 성공 시
                {
                    // 클릭 이벤트 발생
                    mouse_event(0x0002 | 0x0004, 0, 0, 0, 0);
                    UpdateLog($"🎯 [{stepName}] 인식 성공 및 클릭 완료");
                    return true;
                }
                await Task.Delay(200); // CPU 부하 방지를 위한 미세 대기
            }

            UpdateLog($"❌ [{stepName}] 인식 실패 (타임아웃)");
            return false;
        }

        /// <summary>
        /// 지정된 좌표 주변 범위를 탐색하여 이미지가 일치하는지 확인합니다.
        /// </summary>
        private bool SearchImageInRange(CargoButton btn)
        {
            if (btn.Image == null) return false;

            int range = 3;
            int scanSize = 10 + (range * 2); // 10x10 이미지 + 주변 6픽셀 여유 = 16x16

            using (Bitmap bigScreen = new Bitmap(scanSize, scanSize))
            {
                using (Graphics g = Graphics.FromImage(bigScreen))
                {
                    // 캡처 시작점 계산 (이미지의 정중앙 기준 오프셋 적용)
                    int startX = btn.Pos.X - 5 - range;
                    int startY = btn.Pos.Y - 5 - range;

                    if (startX < 0 || startY < 0) return false;

                    // 핵심: 단 한 번만 화면을 캡처함
                    g.CopyFromScreen(startX, startY, 0, 0, new Size(scanSize, scanSize));
                }

                // 캡처된 bigScreen 내에서 0~6픽셀씩 이동하며 비교
                for (int ox = 0; ox <= range * 2; ox++)
                {
                    for (int oy = 0; oy <= range * 2; oy++)
                    {
                        // 메모리 내 비트맵끼리 비교하는 함수 호출
                        if (IsMatchAtDeep(btn.Image, bigScreen, ox, oy)) return true;
                    }
                }
            }
            return false;
        }
        private bool IsMatchAtDeep(Bitmap target, Bitmap screenPart, int offsetX, int offsetY)
        {
            // 10x10 픽셀 비교 루프
            for (int x = 0; x < 10; x++)
            {
                for (int y = 0; y < 10; y++)
                {
                    Color c1 = target.GetPixel(x, y);
                    Color c2 = screenPart.GetPixel(x + offsetX, y + offsetY);

                    // 미세한 색상 차이(RGB 합계 30 이하)는 동일 픽셀로 간주하여 인식률 향상
                    if (Math.Abs(c1.R - c2.R) > 30 || Math.Abs(c1.G - c2.G) > 30 || Math.Abs(c1.B - c2.B) > 30)
                        return false;
                }
            }
            return true;
        }

        // 평균 캡처 (노이즈 제거용)
        private async Task<Bitmap> CaptureAverageImage(Point p)
        {
            // 구현 내용 생략 (기존 코드 유지) - 필요시 이전 코드 참조
            // 간단하게 1장 캡처로 대체하거나 이전의 평균 로직 사용
            Bitmap bmp = new Bitmap(10, 10);
            using (Graphics g = Graphics.FromImage(bmp))
                g.CopyFromScreen(p.X - 5, p.Y - 5, 0, 0, new Size(10, 10));
            return bmp;
        }
