        // 빈 설정 로드/저장 함수 (필요시 내용 채워넣기)

        private void LoadSettings()
        {
            UpdateLog("📂 설정을 로드하는 중...");

            if (!File.Exists(_configPath))
            {
                UpdateLog("⚠️ 설정 파일(config.txt)이 없습니다. 기본값을 사용합니다.");
                return;
            }

            try
            {
                string[] l = File.ReadAllLines(_configPath);
                string myIP = GetLocalIP();
                UpdateLog($"📄 파일 읽기 완료: 총 {l.Length}라인 확인됨.");

                // 1. 상단 3줄에서 IP 매칭 (0, 1, 2번 라인)
                bool matched = false;
                for (int i = 0; i < 3; i++)
                {
                    if (i >= l.Length) break;
                    string[] parts = l[i].Split('|');
                    if (parts.Length == 2 && parts[0] == myIP && parts[1] != "EMPTY")
                    {
                        txtTargetIP.Text = parts[1];
                        matched = true; break;
                    }
                }
                if (!matched) txtTargetIP.Clear();

                // 2. 나머지 설정 로드 (인덱스 3부터 시작)
                if (l.Length >= 15)
                {
                    // 텍스트 필드 로드
                    txtRatioX.Text = l[3];
                    txtRatioY.Text = l[4];
                    txtRepeat.Text = l[5];

                    // 체크박스 안전하게 파싱 (에러 방지용)
                    chkAlwaysOnTop.Checked = TryParseBool(l[6], false);
                    this.TopMost = chkAlwaysOnTop.Checked;

                    // 시간 및 거리 설정
                    txtWaitMatch.Text = l[7];
                    txtWaitAction.Text = l[8];
                    txtWaitNext.Text = l[9];

                    // 기타 옵션
                    chkCaptureEnable.Checked = TryParseBool(l[10], false);
                    chkSoundEnable.Checked = TryParseBool(l[11], true);
                    chkAntiKick.Checked = TryParseBool(l[12], false);
                    chkSyncCagoLV.Checked = TryParseBool(l[13], true);
                    txtSyncDist.Text = l[14];

                    UpdateLog("✅ 기본 환경 설정 로드 성공");
                }
                else
                {
                    UpdateLog("⚠️ 설정 파일 형식이 올바르지 않습니다. (라인 부족)");
                }

                // 2. 17줄 이상이면 좌표 및 이미지 복구
                if (l.Length >= 18)
                {
                    try
                    {
                        _btnDown.Pos = StringToPoint(l[14]);
                        _btnConfirm.Pos = StringToPoint(l[15]);
                        _btnUp.Pos = StringToPoint(l[16]);

                        _btnDown.Image = LoadImageFile("cap_down.png", picDown);
                        _btnConfirm.Image = LoadImageFile("cap_confirm.png", picConfirm);
                        _btnUp.Image = LoadImageFile("cap_up.png", picUp);

                        UpdateLog("🖼️ 버튼 좌표 및 이미지 복구 완료");
                    }
                    catch
                    {
                        UpdateLog("⚠️ 좌표/이미지 데이터 복구 중 오류 발생");
                    }
                }
            }
            catch (Exception ex)
            {
                UpdateLog($"❌ 설정 로드 중 치명적 오류: {ex.Message}");
            }
        }

        private void SaveSettings()
        {
            try
            {
                // 1. 기존 파일 내용을 읽어 IP 이력 3줄을 보존함
                string[] currentFile = File.Exists(_configPath) ? File.ReadAllLines(_configPath) : new string[3];
                List<string> newConfig = new List<string>();

                // 상단 3줄(IP 이력) 그대로 복사
                for (int i = 0; i < 3; i++)
                {
                    newConfig.Add(i < currentFile.Length ? currentFile[i] : "EMPTY|EMPTY");
                }

                // 2. 그 아래에 현재 UI 설정값들 추가 (인덱스 3부터 시작)
                newConfig.Add(txtRatioX.Text);       // index 3
                newConfig.Add(txtRatioY.Text);       // index 4
                newConfig.Add(txtRepeat.Text);       // index 5
                newConfig.Add(chkAlwaysOnTop.Checked.ToString()); // 6
                newConfig.Add(txtWaitMatch.Text);    // 7
                newConfig.Add(txtWaitAction.Text);   // 8
                newConfig.Add(txtWaitNext.Text);     // 9
                newConfig.Add(chkCaptureEnable.Checked.ToString()); // 10
                newConfig.Add(chkSoundEnable.Checked.ToString());   // 11
                newConfig.Add(chkAntiKick.Checked.ToString());      // 12
                newConfig.Add(chkSyncCagoLV.Checked.ToString());    // 13
                newConfig.Add(txtSyncDist.Text);     // 14
                newConfig.Add($"{_btnDown.Pos.X},{_btnDown.Pos.Y}");    // 15
                newConfig.Add($"{_btnConfirm.Pos.X},{_btnConfirm.Pos.Y}"); // 16
                newConfig.Add($"{_btnUp.Pos.X},{_btnUp.Pos.Y}");       // 17

                File.WriteAllLines(_configPath, newConfig);
                SaveImages();
                UpdateLog("💾 설정 및 이미지 저장 완료");
            }
            catch (Exception ex) { UpdateLog($"❌ 저장 실패: {ex.Message}"); }
        }

        /// <summary>
        /// 현재 PictureBox에 표시된 캡처 이미지들을 지정된 폴더에 PNG 파일로 저장합니다.
        /// </summary>
        private void SaveImages()
        {
            try
            {
                // 1. 저장 디렉토리가 없으면 생성
                if (!Directory.Exists(_imgDir))
                {
                    Directory.CreateDirectory(_imgDir);
                    UpdateLog($"📁 이미지 저장 폴더 생성됨: {_imgDir}");
                }

                // 2. 각 이미지를 안전하게 저장 (캡처 데이터가 있을 때만)
                SaveSingleImage(picDown.Image, "cap_down.png");
                SaveSingleImage(picConfirm.Image, "cap_confirm.png");
                SaveSingleImage(picUp.Image, "cap_up.png");

                UpdateLog("💾 모든 캡처 이미지 저장 완료.");
            }
            catch (Exception ex)
            {
                UpdateLog($"❌ 이미지 저장 실패: {ex.Message}");
            }
        }

        /// <summary>
        /// 개별 이미지를 파일로 저장하는 헬퍼 함수
        /// </summary>
        private void SaveSingleImage(Image img, string fileName)
        {
            if (img == null) return;

            string fullPath = Path.Combine(_imgDir, fileName);

            try
            {
                // 파일이 이미 존재한다면 교체하기 위해 새 비트맵으로 복사 후 저장
                // (기존 파일이 로드되어 사용 중인 경우를 대비)
                using (Bitmap bmpToSave = new Bitmap(img))
                {
                    bmpToSave.Save(fullPath, ImageFormat.Png);
                }
            }
            catch (IOException)
            {
