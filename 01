        // 마우스 다운: 드래그 시작
        private void OnMouseDown(object sender, MouseEventArgs e)
        {
            if (chkCaptureEnable.Checked && e.Button == MouseButtons.Left)
            {
                _dragStart = e.Location;
                _isDragging = true;
            }
        }

        // 마우스 무브: 드래그 영역 계산 및 오버레이 갱신
        private void OnMouseMove(object sender, MouseEventArgs e)
        {
            if (_isDragging)
            {
                _dragRect = new Rectangle(
                    Math.Min(_dragStart.X, e.X), Math.Min(_dragStart.Y, e.Y),
                    Math.Abs(_dragStart.X - e.X), Math.Abs(_dragStart.Y - e.Y)
                );
                // 오버레이 창에 현재 드래그 중인 영역 표시 요청
                _overlay.CurrentDragRect = _dragRect;
                _overlay.Invalidate();
            }
        }

        // 마우스 업: 드래그 종료 및 해당 영역 캡처
        private async void OnMouseUp(object sender, MouseEventArgs e)
        {
            if (_isDragging)
            {
                _isDragging = false;
                if (_dragRect.Width > 5 && _dragRect.Height > 5)
                {
                    Bitmap capturedBmp = CaptureRectImage(_dragRect);
                    await ProcessCapturedItem(capturedBmp, _dragRect); // 순차 저장 로직
                }
                _overlay.CurrentDragRect = Rectangle.Empty;
                _overlay.Invalidate();
            }
        }
        private Bitmap CaptureRectImage(Rectangle rect)
        {
            // 화면 크기만큼의 도화지를 준비합니다.
            Bitmap bmp = new Bitmap(rect.Width, rect.Height);
            using (Graphics g = Graphics.FromImage(bmp))
            {
                // 화면(Screen)에서 rect 영역만 복사해서 도화지에 그립니다.
                g.CopyFromScreen(rect.Left, rect.Top, 0, 0, rect.Size);
            }
            return bmp;
        }
        private async Task ProcessCapturedItem(Bitmap capturedBmp, Rectangle rect)
        {
            string fileName = "";
            string dateStr = DateTime.Now.ToString("yyyyMMdd");
            string buildVer = "v1.4.0"; // 사용자님의 버전 규칙 적용

            switch (_captureIndex)
            {
                case 0: // ⚓ Anchor
                    _anchorImage = (Bitmap)capturedBmp.Clone();
                        _overlay.AnchorImage = _anchorImage;
                        _overlay.AnchorPos = rect.Location;
                        fileName = $"Anchor_{dateStr}_{buildVer}.png";
                        UpdateLog("⚓ 앵커 수집 완료 (가이드 활성화)");
                        break;                    
                case 1: // ⬇️ Down
                    _btnDown = new CargoButton { Pos = GetCenter(rect), Image = capturedBmp, Name = "Down" };
                    picDown.Image = (Bitmap)capturedBmp.Clone();
                    fileName = $"Down_{dateStr}_{buildVer}.png";
                    break;
                case 2: // ✅ Confirm
                    _btnConfirm = new CargoButton { Pos = GetCenter(rect), Image = capturedBmp, Name = "Confirm" };
                    picConfirm.Image = (Bitmap)capturedBmp.Clone();
                    fileName = $"Confirm_{dateStr}_{buildVer}.png";
                    break;
                case 3: // ⬆️ Up
                    _btnUp = new CargoButton { Pos = GetCenter(rect), Image = capturedBmp, Name = "Up" };
                    picUp.Image = (Bitmap)capturedBmp.Clone();
                    fileName = $"Up_{dateStr}_{buildVer}.png";
                    break;
            }

            // PNG로 저장
            if (!string.IsNullOrEmpty(fileName))
                capturedBmp.Save(Path.Combine(Application.StartupPath, fileName), System.Drawing.Imaging.ImageFormat.Png);

            _captureIndex = (_captureIndex + 1) % 4; // 0,1,2,3 순환
            UpdateOverlayRects();
        }
        // 사각형의 중앙 좌표를 구해주는 간단한 함수
        private Point GetCenter(Rectangle r) => new Point(r.X + r.Width / 2, r.Y + r.Height / 2);
        private Rectangle GetRect(Point p1, Point p2) => new Rectangle(
            Math.Min(p1.X, p2.X), Math.Min(p1.Y, p2.Y),
            Math.Abs(p1.X - p2.X), Math.Abs(p1.Y - p2.Y));
