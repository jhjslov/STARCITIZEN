        // [이벤트] 연결/대기 버튼 클릭 (하나의 버튼으로 두 역할 처리)
        private async void btnConnect_Click(object sender, EventArgs e)
        {
            // 이미 연결 상태라면 연결 끊기
            if (_isConnected)
            {
                Disconnect();
                return;
            }

            if (_isMasterRole)
            {
                // [마스터] 서버 시작 및 대기
                try
                {
                    _listener = new TcpListener(IPAddress.Any, 9000);
                    _listener.Start();
                    UpdateLog("⏳ [SERVER] 보조 PC의 접속을 기다리는 중...");
                    btnConnect.Text = "접속 대기 중...";

                    _client = await _listener.AcceptTcpClientAsync();
                    StartSession(); // 연결 성공 처리
                    await Task.Delay(1500);
                    AutoSaveIPHistory(txtTargetIP.Text);
                }
                catch (Exception ex) { UpdateLog($"❌ 서버 오류: {ex.Message}"); }
            }
            else
            {
                // [보조] 마스터 IP로 접속 시도
                try
                {
                    _client = new TcpClient();
                    string targetIP = txtTargetIP.Text.Trim(); // UI의 타겟 IP 입력창
                    UpdateLog($"⏳ [CLIENT] 마스터({targetIP}) 접속 시도...");

                    await _client.ConnectAsync(targetIP, 9000);
                    StartSession(); // 연결 성공 처리
                    AutoSaveIPHistory(txtTargetIP.Text);
                }
                catch (Exception ex) { UpdateLog($"❌ 접속 실패: {ex.Message}"); }
            }
        }

        // 연결 성공 시 초기화
        private void StartSession()
        {
            _stream = _client.GetStream();
            _isConnected = true;
            UpdateLog("✅ 네트워크 연결 성공!");

            if (this.InvokeRequired) this.Invoke(new Action(() => btnConnect.Text = "연결 종료"));
            else btnConnect.Text = "연결 종료";

            ReceiveMessagesLoop(); // 수신 루프 시작
        }

        // 연결 종료 및 리소스 해제
        private void Disconnect()
        {
            _isConnected = false;
            if (_stream != null) _stream.Close();
            if (_client != null) _client.Close();
            if (_listener != null) _listener.Stop();

            UpdateLog("🔌 연결이 종료되었습니다.");
            UpdateRoleUI(); // 버튼 텍스트 원상복구
        }

        // 데이터 송신 (마스터 -> 보조 or 보조 -> 마스터)
        private void SendCommand(string command)
        {
            FlashStatusLabel();

            if (_stream != null && _client != null && _client.Connected)
            {
                try
                {
                    // 명령 끝에 개행 문자(\n)를 반드시 추가하여 데이터의 끝을 알림
                    byte[] data = Encoding.UTF8.GetBytes(command + "\n");
                    _stream.Write(data, 0, data.Length);
                    _stream.Flush(); // 즉시 전송 보장
                    if (!command.StartsWith("MOVE|"))   // [수정] MOVE 명령이 아닐 때만 로그를 출력합니다.
                    {
                        UpdateLog($"[Send] {command}");
                    }
                }
                catch (Exception ex)
                {
                    UpdateLog($"❌ 전송 실패: {ex.Message}");
                }
            }
        }

        // 데이터 수신 루프 (비동기)
        private async void ReceiveMessagesLoop()
        {
            byte[] buffer = new byte[1024];
            while (_isConnected)
            {
                try
                {
                    int bytesRead = await _stream.ReadAsync(buffer, 0, buffer.Length);
                    if (bytesRead == 0) break; // 연결 끊김 감지

                    string msg = Encoding.UTF8.GetString(buffer, 0, bytesRead).Trim();
                    ProcessMessage(msg); // 메시지 해석
                }
                catch { break; }
            }
            Disconnect();
        }

        // 수신된 메시지 처리
        private async void ProcessMessage(string msg)
        {
            if (string.IsNullOrEmpty(msg)) return;
            if (!msg.StartsWith("MOVE")) UpdateLog($"[Recv] {msg}");
            string[] parts = msg.Split('|');
            string cmd = parts[0];

            // 1. MOVE 신호는 로그를 찍지 않고 최상단에서 바로 처리
            if (cmd == "MOVE" && parts.Length == 3)
            {
                // 1. 원본 델타값 파싱
                int rawDx = int.Parse(parts[1]);
                int rawDy = int.Parse(parts[2]);

                // 2. 텍스트박스에서 배율 가져오기 (기본값 1.0)
                double ratioX = 1.0;
                double ratioY = 1.0;
                double.TryParse(txtRatioX.Text, out ratioX); // 입력값이 숫자가 아니면 0 또는 1이 됨에 주의
                double.TryParse(txtRatioY.Text, out ratioY);

                // 입력값이 비어있거나 0이면 1.0으로 안전장치
                if (ratioX == 0) ratioX = 1.0;
                if (ratioY == 0) ratioY = 1.0;

                // 3. 배율 적용 (소수점은 버림)
                int finalDx = (int)(rawDx * ratioX);
                int finalDy = (int)(rawDy * ratioY);

                // 4. 이동 실행 (로그 없이 즉시 실행)
                mouse_event(0x0001, finalDx, finalDy, 0, 0);
                return;
            }

            FlashStatusLabel();
            // 2. 키보드 제어 (스캔코드 방식 유지)
            if ((cmd == "KD" || cmd == "KU") && parts.Length == 2)
            {
                int vk = int.Parse(parts[1]);
                uint scanCode = MapVirtualKey((uint)vk, 0);
                uint flags = 0x0008; // MOUSEEVENTF_SCANCODE

                if (cmd == "KU") flags |= 0x0002; // KEYEVENTF_KEYUP

                // 첫 번째 인자에 vk를 넣어주는 것이 더 안정적입니다.
                keybd_event((byte)vk, (byte)scanCode, flags, 0);
            }
            if (cmd == "SET_SYNC" && parts.Length == 2)
            {
                bool isChecked = bool.Parse(parts[1]);
                this.Invoke((MethodInvoker)delegate
                {
                    chkSyncCagoLV.Checked = isChecked; // 서브 PC의 UI를 메인과 동일하게 변경
                });
            }
            else if (cmd == "SET_MANUAL" && parts.Length == 2)
            {
                bool isChecked = bool.Parse(parts[1]);
                this.Invoke((MethodInvoker)delegate
                {
                    chkSubManual.Checked = isChecked;
                });
            }
            else if (cmd == "SET_AntiKick" && parts.Length == 2)
            {
                bool isChecked = bool.Parse(parts[1]);
                this.Invoke((MethodInvoker)delegate
                {
                    chkAntiKick.Checked = isChecked;
                });
            }
            else if (_isMasterRole)
            {
                // ==========================================
                // [메인 PC] 서브 PC로부터의 응답 처리
                // ==========================================
                if (msg == "SUB_READY")
                {
                    _isSubReady = true;
                    UpdateLog("✅ 서브 PC로부터 응답 수신 (다음 단계 진행 가능)");
                }
            }

            // 2. 기존 자동화 신호 처리 (SUB_ACTION_1, 2 등)
            // --- 상황 A: 서브 수동 모드 (사용자 클릭 대기) ---
            else if (chkSubManual.Checked)
            {
                if (msg == "SUB_ACTION_1" || msg == "SUB_ACTION_2")
                {
                    UpdateLog($"📥 [수동 모드] 메인 신호({msg}) 수신. 화면을 직접 클릭하세요!");
                    _waitingForUserClick = true;
                    return; // 아래의 자동 실행 로직을 타지 않도록 종료
                }
            }
            // --- 상황 B: 서브 자동 모드 (기존 매크로 실행) ---
            if (msg == "SUB_ACTION_1") // 첫 번째 클릭 신호
            {
                UpdateLog("📡 1차 클릭 신호 수신");
                // 첫 번째 클릭은 평소대로 (SyncMove 미적용)
                mouse_event(0x0002 | 0x0004, 0, 0, 0, 0);
                SendCommand("SUB_READY"); // 완료 신호 회신
            }
            else if (msg == "SUB_ACTION_2") // 두 번째 클릭 신호 (SyncCagoLV 적용 구간)
            {
                UpdateLog("📡 2차 동작 신호 수신 (상대 이동 보정)");

                // 1. 설정값 가져오기
                bool isElevatorCorrectionEnabled = chkSyncCagoLV.Checked;
                int dist = GetInt(txtSyncDist, 5); // 이동할 픽셀 거리

                if (isElevatorCorrectionEnabled)
                {
                    // [핵심] 0x0001 플래그는 현재 위치에서 dx, dy만큼 '이동'시킵니다.
                    // mouse_event(dwFlags, dx, dy, dwData, dwExtraInfo)
                    UpdateLog($"🖱️ 마우스 {dist}px 하강 이동");
                    mouse_event(0x0001, 0, dist, 0, 0);

                    // 이동 후 게임이 인식할 수 있도록 아주 짧은 물리적 대기시간 부여
                    await Task.Delay(500);
                }

                // 2. 실제 클릭 실행
                mouse_event(0x0002 | 0x0004, 0, 0, 0, 0);

                // 3. 클릭 후 상승 (200ms 대기 후)
                if (isElevatorCorrectionEnabled)
                {
                    // 3. 사용자 요청: 클릭 후 200ms 대기
                    await Task.Delay(500);

                    // 4. 다시 원래 위치로 상승 이동
                    UpdateLog($"🖱️ 마우스 {dist}px 상승 복귀");
                    mouse_event(0x0001, 0, -dist, 0, 0);
                }

                SendCommand("SUB_READY"); // 완료 신호 회신
                UpdateLog("✅ 2차 클릭 및 싱크 보정 완료");
            }
        }
