        private void AutoSaveIPHistory(string targetIP) //최근 점속 성공 IP 자동 저장
        {
            try
            {
                string myIP = GetLocalIP();
                string currentPair = $"{myIP}|{targetIP}";

                // 1. 기존 파일의 모든 내용을 읽어옴
                List<string> allLines = File.Exists(_configPath)
                    ? File.ReadAllLines(_configPath).ToList()
                    : new List<string>();

                // 2. 현재 파일에서 기존 IP 이력(상단 3줄) 추출 및 정리
                List<string> ipPairs = new List<string>();
                for (int i = 0; i < Math.Min(3, allLines.Count); i++)
                {
                    if (allLines[i].Contains("|")) ipPairs.Add(allLines[i]);
                }

                // 3. 현재 접속 성공한 쌍을 최상단으로 (중복 제거)
                ipPairs.Remove(currentPair);
                ipPairs.Insert(0, currentPair);
                if (ipPairs.Count > 3) ipPairs = ipPairs.Take(3).ToList();

                // 4. 파일 내용 재구성 (상단 3줄은 새 이력, 4줄부터는 기존 내용 유지)
                List<string> newConfig = new List<string>();
                for (int i = 0; i < 3; i++)
                {
                    newConfig.Add(i < ipPairs.Count ? ipPairs[i] : "EMPTY|EMPTY");
                }

                // 5. 4번째 줄(인덱스 3)부터의 기존 설정이 있다면 그대로 붙임
                if (allLines.Count > 3)
                {
                    newConfig.AddRange(allLines.Skip(3));
                }

                File.WriteAllLines(_configPath, newConfig);
                UpdateLog($"✅ 접속 성공: IP 이력 자동 업데이트 완료 ({currentPair})");
            }
            catch (Exception ex) { UpdateLog($"❌ IP 자동 저장 실패: {ex.Message}"); }
        }

        private void UpdateOverlayRects()
        {
            if (_overlay == null || _overlay.IsDisposed) return;

            _overlay.RectsToDraw.Clear();

            // 1. Down 버튼 (중심점 보정 계산)
            if (_btnDown.Image != null)
            {
                int w = _btnDown.Image.Width;
                int h = _btnDown.Image.Height;
                // 좌표에서 크기의 절반을 빼서 좌상단 시작점을 찾음
                _overlay.RectsToDraw.Add(new OverlayItem
                {
                    Rect = new Rectangle(_btnDown.Pos.X - (w / 2), _btnDown.Pos.Y - (h / 2), w, h),
                    Label = "Down"
